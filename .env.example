# ==============================================================================
# ABHIVOX TECHNOLOGIES — Environment Configuration Template
# Project: tech.abhivox.online
# Copy this file to .env and provide your actual values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (Exposed to browser via Vite)
# ------------------------------------------------------------------------------
# Public Supabase project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key (Safe for browser: restricted by Row Level Security)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key


# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (NEVER exposed to frontend bundle or browser)
# ------------------------------------------------------------------------------
# Optional: Supabase Service Role Key (Grants elevated server privileges, bypasses RLS)
# If omitted, backend uses the Anon Key with the public INSERT RLS policy.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Resend API Key for automated email notifications (https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# Expected sender configuration:
# Note: Before production delivery, verify your domain in Resend.
# During testing before domain verification, you can use "onboarding@resend.dev".
RESEND_FROM_EMAIL="ABHIVOX TECHNOLOGIES <inquiries@tech.abhivox.online>"

# Notification recipient email address where new project scope alerts are sent
CONTACT_NOTIFICATION_EMAIL=abhishek@abhivox.online


# ------------------------------------------------------------------------------
# 3. DATABASE SETUP INSTRUCTIONS
# ------------------------------------------------------------------------------
# To set up the project_inquiries table in Supabase:
# 1. Go to your Supabase Project Dashboard -> SQL Editor
# 2. Open and run the migration script located at:
#    supabase/migrations/20261028_create_project_inquiries.sql
# 3. The migration automatically enables Row Level Security (RLS) so visitors
#    can submit inquiries, but cannot read or modify other records.
